# ---- Backend API ----
# Base URL of the Express backend (no trailing slash)
VITE_SERVER_URL=http://localhost:3001

# ---- Resume upload worker ----
# Cloudflare Worker that accepts resume uploads and returns a public URL.
# The hostname of the URL it returns must be listed in the backend's
# RESUME_STORAGE_HOSTS, or /api/portfolio/generate will reject it.
VITE_API_URL=https://your-upload-worker.your-subdomain.workers.dev
