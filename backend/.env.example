# ---- Server ----
PORT=3001
NODE_ENV=development
# Origin allowed by CORS — must match where the frontend is served from
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database ----
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (used by prisma migrate) — omit the "-pooler" part
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string

# ---- Resume storage allowlist ----
# Comma-separated hostnames only — no scheme, no path.
# The API refuses to fetch a resumeUrl whose host is not listed here.
RESUME_STORAGE_HOSTS=your-bucket.r2.dev

# ---- AI (NVIDIA NIM) ----
NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Per-stage model overrides — see src/config/ai.ts
ARCHITECT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
BLUEPRINT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CODE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
RESUME_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- Deployment ----
# Vercel token used by the deploy task
VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx
